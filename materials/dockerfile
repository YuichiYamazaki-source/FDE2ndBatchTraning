FROM python:3.12-slim

WORKDIR /app

# ===========================
# システムパッケージのインストール
# ===========================
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    nodejs \
    npm \
    default-jdk \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ===========================
# Java環境変数（PySpark用）
# ===========================
ENV JAVA_HOME=/usr/lib/jvm/default-java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ===========================
# Python venv の作成
# ===========================
RUN python -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"
RUN pip install --upgrade pip

# ===========================
# Pythonライブラリのインストール
# ===========================
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ===========================
# ポート開放
# ===========================
# API (MicroService用 10ポート)
EXPOSE 8000
EXPOSE 8001
EXPOSE 8002
EXPOSE 8003
EXPOSE 8004
EXPOSE 8005
EXPOSE 8006
EXPOSE 8007
EXPOSE 8008
EXPOSE 8009

# Jupyter Notebook
EXPOSE 8888

# React (フロントエンド)
EXPOSE 3000

# DB
# MongoDB
# PostgreSQL
# MySQL
# Redis
EXPOSE 27017  
EXPOSE 5432   
EXPOSE 3306   
EXPOSE 6379   

COPY . .

CMD ["bash"]
