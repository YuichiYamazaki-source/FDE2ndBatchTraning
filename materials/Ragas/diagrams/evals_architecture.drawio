        <mxCell id="metrics" value="&lt;b&gt;metrics.py&lt;/b&gt;&lt;br&gt;LLM-as-Judge (gpt-4o-mini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- 6 Metrics boxes -->
        <mxCell id="m1" value="&lt;b&gt;faithfulness&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;claims in response&lt;br&gt;supported by contexts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#4a86c8;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="80" y="470" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="&lt;b&gt;answer_relevancy&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;reverse question gen&lt;br&gt;+ embedding similarity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#4a86c8;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="250" y="470" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="&lt;b&gt;context_relevance&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;are retrieved docs&lt;br&gt;relevant to query?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#4a86c8;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="420" y="470" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="&lt;b&gt;context_precision&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;relevant contexts&lt;br&gt;ranked higher?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#4a86c8;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="590" y="470" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="&lt;b&gt;context_recall&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;GT statements covered&lt;br&gt;by contexts? (needs GT)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#4a86c8;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="760" y="470" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="&lt;b&gt;hallucination_detection&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;claims contradicting&lt;br&gt;or unsupported&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#4a86c8;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="940" y="470" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- ========== Row 4: Results ========== -->
        <mxCell id="label-results" value="Step 5: Results" style="text;html=1;fontSize=14;fontStyle=5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="580" width="140" height="30" as="geometry" />
        </mxCell>

        <mxCell id="eval-json" value="&lt;b&gt;eval_YYYYMMDD_HHMMSS.json&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;scores_summary + per_question details&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="300" y="580" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ========== Row 5: Quality Gates ========== -->
        <mxCell id="label-qa" value="Quality Gates" style="text;html=1;fontSize=14;fontStyle=5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="690" width="140" height="30" as="geometry" />
        </mxCell>

        <mxCell id="pytest" value="&lt;b&gt;test_quality.py&lt;/b&gt; (pytest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="680" width="240" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="&lt;b&gt;TestQA&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;faithfulness &gt;= 0.5&lt;br&gt;answer_relevancy &gt;= 0.5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="140" y="750" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;TestHallucination&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;hallucination &lt;= 0.5&lt;br&gt;no complete hallucination&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="340" y="750" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;TestValidation&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;context_relevance &gt;= 0.4&lt;br&gt;context_recall &gt;= 0.4 (if GT)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="550" y="750" width="190" height="60" as="geometry" />
