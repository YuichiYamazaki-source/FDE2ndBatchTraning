        </mxCell>

        <!-- testset sm/md/lg -->
        <mxCell id="testset-sm" value="&lt;b&gt;testset_sm.json&lt;/b&gt;&lt;br&gt;4 questions&lt;br&gt;&lt;font size=&quot;1&quot;&gt;(quick test ~3min)&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="150" height="70" as="geometry" />
        </mxCell>

        <mxCell id="testset-md" value="&lt;b&gt;testset_md.json&lt;/b&gt;&lt;br&gt;8 questions&lt;br&gt;&lt;font size=&quot;1&quot;&gt;(balanced ~7min)&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="250" y="120" width="150" height="70" as="geometry" />
        </mxCell>

        <mxCell id="testset-lg" value="&lt;b&gt;testset_lg.json&lt;/b&gt;&lt;br&gt;15 questions&lt;br&gt;&lt;font size=&quot;1&quot;&gt;(full ~15min)&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Golden DB -->
        <mxCell id="golden-db" value="&lt;b&gt;golden_db.json&lt;/b&gt;&lt;br&gt;15 GT entries&lt;br&gt;&lt;font size=&quot;1&quot;&gt;LLM-generated&lt;br&gt;+ human-reviewed&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="golden-script" value="&lt;b&gt;golden_db.py&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;--apply: merge GT&lt;br&gt;into testset.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="130" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- ========== Row 2: Eval Runner ========== -->
        <mxCell id="label-runner" value="Step 1-3: Collect" style="text;html=1;fontSize=14;fontStyle=5;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="240" width="140" height="30" as="geometry" />
        </mxCell>

        <mxCell id="eval-runner" value="&lt;b&gt;eval_runner.py&lt;/b&gt;&lt;br&gt;Main Pipeline Script&lt;br&gt;&lt;font size=&quot;1&quot;&gt;--testset: select sm/md/lg&lt;br&gt;--skip-collect: reuse responses&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="300" y="240" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Agent execution -->
        <mxCell id="agent-exec" value="&lt;b&gt;Orchestrator Agent&lt;/b&gt;&lt;br&gt;(capturing tools)&lt;br&gt;&lt;font size=&quot;1&quot;&gt;All 4 tool outputs captured&lt;br&gt;as contexts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="240" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- collected_latest.json -->
        <mxCell id="collected" value="&lt;b&gt;collected_latest.json&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;1&quot;&gt;{query, contexts[], response,&lt;br&gt;ground_truth}&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="940" y="245" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- ========== Row 3: Metrics ========== -->
